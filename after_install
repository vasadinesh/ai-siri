
#!/bin/bash
set -e

APP_DIR="/var/www/html"

echo "Preparing application directory..."
mkdir -p "$APP_DIR"

echo "Checking package.json locations..."
find "$APP_DIR" -name package.json -type f

if [ -f "$APP_DIR/backend/package.json" ]; then
    echo "Installing backend dependencies..."
    cd "$APP_DIR/backend"
    npm install --omit=dev
fi

if [ -f "$APP_DIR/frontend/package.json" ]; then
    echo "Installing frontend dependencies..."
    cd "$APP_DIR/frontend"
    npm install --omit=dev
fi

if [ ! -f "$APP_DIR/backend/package.json" ] && \
   [ ! -f "$APP_DIR/frontend/package.json" ]; then
    echo "ERROR: No package.json found in backend or frontend."
    exit 1
fi

echo "AfterInstall completed successfully."
